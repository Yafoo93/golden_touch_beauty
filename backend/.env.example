DJANGO_SECRET_KEY=replace-with-a-long-random-secret
USE_R2_STORAGE=False

# Cloudflare R2 media storage. Leave disabled for local filesystem storage.
# Never commit real access keys. The public and private buckets use separate,
# bucket-scoped Object Read & Write credentials.
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_BUCKET=golden-touch-public-media
R2_PUBLIC_ACCESS_KEY_ID=
R2_PUBLIC_SECRET_ACCESS_KEY=
R2_PUBLIC_CUSTOM_DOMAIN=pub-example.r2.dev
R2_PRIVATE_BUCKET=golden-touch-private-media
R2_PRIVATE_ACCESS_KEY_ID=
R2_PRIVATE_SECRET_ACCESS_KEY=
R2_PRIVATE_URL_EXPIRY=300
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_LOG_LEVEL=INFO

POSTGRES_DB=golden_touch_beauty
POSTGRES_USER=golden_touch
POSTGRES_PASSWORD=golden_touch_local
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Production platforms can provide DATABASE_URL instead of the five
# POSTGRES_* variables above.
# DATABASE_URL=postgresql://user:password@host:5432/database

FRONTEND_URL=http://127.0.0.1:3000
DEFAULT_FROM_EMAIL=Golden Touch Beauty Centre <noreply@goldentouch.local>
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_USE_SSL=False
DJANGO_EMAIL_TIMEOUT=15
EMAIL_VERIFICATION_MAX_AGE_SECONDS=86400

# Local tests use SQLite by default. CI overrides this with PostgreSQL.
TEST_DATABASE_ENGINE=sqlite

# Production example (set these in Render, not in this file):
# DJANGO_SETTINGS_MODULE=config.settings.production
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<unique random value of at least 50 characters>
# DJANGO_ALLOWED_HOSTS=golden-touch-beauty.onrender.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://golden-touch-frontend.onrender.com
# FRONTEND_URL=https://golden-touch-frontend.onrender.com
# DATABASE_URL=<Render PostgreSQL internal connection URL>
# DJANGO_SECURE_HSTS_SECONDS=31536000
